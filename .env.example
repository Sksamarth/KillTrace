# Copy to .env; never commit real credentials. No key is needed for this phase.
KILLCHAIN_DATA_DIR=./data
# Optional development-only Vite API proxy override (never a production endpoint).
KILLCHAIN_DEV_API=
KILLCHAIN_DUCKDB_MEMORY_LIMIT=1GB
KILLCHAIN_DUCKDB_THREADS=2
KILLCHAIN_DUCKDB_MAX_TEMP_SIZE=10GB
# Reserved for future Gemini integration; no external AI calls are implemented.
GEMINI_API_KEY=

# Optional input directory; blank/unset uses KILLCHAIN_DATA_DIR.
# KILLCHAIN_INGESTION_INPUT_DIR=./data
KILLCHAIN_INGESTION_BATCH_ROWS=4096
KILLCHAIN_INGESTION_BATCH_BYTES=8388608
KILLCHAIN_INGESTION_ROW_GROUP_ROWS=1024
# Soft current-process RSS admission limit, checked between records/batches.
KILLCHAIN_INGESTION_MEMORY_MB=768
KILLCHAIN_INGESTION_TEMP_BYTES=67108864
KILLCHAIN_INGESTION_DISK_RESERVE_BYTES=268435456
