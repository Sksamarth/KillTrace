{
  "name": "killchain-ai-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop:web": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "test:desktop": "node --test tests/desktop.test.mjs",
    "test": "node --experimental-strip-types --test tests/desktop.test.mjs tests/scanner.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "cytoscape": "^3.31.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/cytoscape": "^3.21.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.0",
    "vite": "^6.3.0"
  }
}
